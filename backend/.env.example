# =====================================================================
# SMARTRETAIL AI - Backend Environment Configuration Template
# =====================================================================

# Application Configuration
APP_NAME="SmartRetail AI Backend"
APP_ENV=development
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/smartretail_db"

# Fallback Database for Local Testing / Offline Verification
# If PostgreSQL is not currently running locally, setting this to true allows
# running instant table creation & health checks with SQLite.
ALLOW_SQLITE_FALLBACK=True
SQLITE_FALLBACK_URL="sqlite:///./smartretail_dev.db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Security & Future Auth Configuration (Stage 4)
SECRET_KEY="supersecret_capstone_jwt_key_replace_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Configuration (Stage 5)
OPENAI_API_KEY=""
